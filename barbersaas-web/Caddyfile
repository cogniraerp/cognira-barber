# Servidor estático de la web dentro del contenedor (HTTP :80). El HTTPS lo pone el proxy de
# delante (Traefik en Coolify, o el Caddy de deploy/, que monta su propio Caddyfile encima).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Solo nuestro JS; estilos y fuentes de Google Fonts; imágenes https (R2); llamadas solo a la API.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' {$API_ORIGIN}; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
