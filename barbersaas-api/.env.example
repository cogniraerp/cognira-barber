# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
# api | worker
APP_MODE=api
PORT=3100
LOG_LEVEL=debug

# ── Base de datos ───────────────────────────────────────
# Usuario de runtime: miembro de barbersaas_app, SIN bypass de RLS.
DATABASE_URL=postgresql://barbersaas_api:barbersaas_api@localhost:55432/barbersaas
# Usuario dueño de las tablas: solo migraciones y seed.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/barbersaas

# ── Auth ────────────────────────────────────────────────
# local = la API emite sus propios JWT (desarrollo). supabase = se valida contra el JWKS de Supabase (más adelante).
AUTH_PROVIDER=local
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-123456
JWT_ISSUER=barbersaas-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# ── Cifrado de secretos de integraciones (AES-256-GCM) ─
# 32 bytes en base64. Genera uno con: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ENCRYPTION_KEY_VERSION=1

# ── Dominios / CORS ─────────────────────────────────────
ROOT_DOMAIN=barbersaas.localhost
WEB_URL=http://localhost:5180
# Orígenes extra separados por coma (además de ROOT_DOMAIN y sus subdominios)
CORS_ORIGINS=http://localhost:5180

# ── Storage ─────────────────────────────────────────────
# local = disco del servidor (servido en /files) · s3 = bucket S3 compatible (Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_API_URL=http://localhost:3100
# Solo con STORAGE_DRIVER=s3. Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://media.tudominio.pe   (dominio propio del bucket, o la URL pública r2.dev)
# S3 local para probar: docker compose --profile s3 up -d s3 →
#   S3_ENDPOINT=http://localhost:59000  S3_BUCKET=media  S3_PUBLIC_URL=http://localhost:59000/media  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ── Datos legales de Cognira (Términos, Privacidad y Libro de Reclamaciones) ──
# En producción son obligatorios: la API no arranca sin ellos.
LEGAL_TRADE_NAME="Cognira Barber"
LEGAL_NAME=
LEGAL_RUC=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ── Email (Resend) — opcional en local; sin clave se imprime en consola ──
# Opción A: Gmail por SMTP (tiene prioridad). Requiere verificación en 2 pasos y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opción B: Resend
RESEND_API_KEY=
EMAIL_FROM="BarberSaaS <no-reply@barbersaas.com>"

# ── WhatsApp de la plataforma — opcional en local ───────
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev-verify-token
META_APP_SECRET=
# WhatsApp por QR con Evolution API (no oficial; cada barbería vincula su número desde Mensajes).
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_PLATFORM_INSTANCE=cognira-plataforma
# cloud = Meta (oficial) · evolution = número de Cognira vinculado por QR
WHATSAPP_PLATFORM_PROVIDER=cloud
WHATSAPP_PLATFORM_WABA_ID=
WHATSAPP_GRAPH_VERSION=v21.0
NOTIFICATIONS_POLL_MS=2000

# ── Seed (pnpm db:seed) ─────────────────────────────────
SEED_SUPERADMIN_EMAIL=admin@barbersaas.pe
SEED_SUPERADMIN_PASSWORD=admin-1234
# Datos demo (2 barberías, barberos, clientes y citas). Solo fuera de producción.
SEED_DEMO=true
# true = borra y recrea las barberías demo
SEED_DEMO_RESET=false

# ── Límites anti-abuso por IP (subirlos solo en local/CI para correr los E2E) ──
# AUTH_RATE_LIMIT_PER_MINUTE=10
# PUBLIC_BOOKINGS_PER_HOUR=10
