# ══ Cognira Barber · producción ══════════════════════════════════════════════
# Copia este archivo a deploy/.env en el servidor y complétalo. NUNCA lo subas a ningún lado.
# Genera los secretos con: sh deploy/scripts/gen-secrets.sh

# ── Dominio y HTTPS ───────────────────────────────────────────────────────────
# Dominio raíz: app.DOMAIN (panel), api.DOMAIN (API), {slug}.DOMAIN (cada barbería).
DOMAIN=cognirabarber.pe
# Correo para Let's Encrypt (avisos de certificados).
ACME_EMAIL=

# ── Base de datos (secretos) ──────────────────────────────────────────────────
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── API (secretos) ────────────────────────────────────────────────────────────
JWT_SECRET=
# 32 bytes en base64. ¡Guárdala aparte! Sin ella no se pueden leer las credenciales cifradas (pasarelas, WhatsApp).
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
LOG_LEVEL=log

# ── Datos legales de Cognira (obligatorios) ───────────────────────────────────
LEGAL_TRADE_NAME="Cognira Barber"
LEGAL_NAME=
LEGAL_RUC=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# ── Archivos: Cloudflare R2 ───────────────────────────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=cognira-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://media.cognirabarber.pe

# ── Correo (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Cognira Barber <no-reply@cognirabarber.pe>"

# ── WhatsApp de la plataforma (Meta Cloud API) ────────────────────────────────
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_PLATFORM_ACCESS_TOKEN=
WHATSAPP_PLATFORM_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Avisos de cobranza por WhatsApp: false hasta que Meta apruebe las plantillas.
BILLING_WHATSAPP_ENABLED=false

# ── Monitoreo de errores (opcional, sentry.io) ────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Primer superadmin (solo para el seed inicial) ─────────────────────────────
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO=false

# ── Backups fuera del servidor (recomendado: un bucket R2 privado aparte) ─────
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
